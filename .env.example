# Copy to .env for local runs. Every value shown is the built-in default.
AGENTORC_DATABASE_URL=postgresql+psycopg://orch:orch@localhost:5432/orch
AGENTORC_REDIS_URL=redis://localhost:6379/0

# redis | postgres  ("postgres" runs the whole engine with no Redis at all)
AGENTORC_QUEUE_BACKEND=redis

# Reliability timings. lease_ttl must exceed the slowest legitimate step;
# stalled_message_idle_ms must exceed lease_ttl (enforced at startup).
AGENTORC_LEASE_TTL_SECONDS=60
AGENTORC_REAPER_INTERVAL_SECONDS=2
AGENTORC_ENQUEUE_GRACE_SECONDS=5
AGENTORC_STALLED_MESSAGE_IDLE_MS=90000

AGENTORC_WORKER_CONCURRENCY=4
AGENTORC_LOG_JSON=true
AGENTORC_LOG_LEVEL=INFO

# Guardrails
AGENTORC_APPROVAL_TTL_SECONDS=86400
AGENTORC_MAX_CONSECUTIVE_INVALID_TOOL_CALLS=3
AGENTORC_RESERVE_FINAL_ANSWER_STEP=true

# LLM. "fake" is a scripted, deterministic provider and is the default so that a
# misconfigured deployment cannot silently start spending money.
AGENTORC_LLM_PROVIDER=fake
AGENTORC_LLM_MODEL=claude-opus-5
AGENTORC_LLM_MAX_TOKENS=8000
AGENTORC_LLM_EFFORT=high

# Lets a step deliberately crash its own worker. Tests and demos only.
AGENTORC_ENABLE_FAULT_INJECTION=false
